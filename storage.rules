rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ============================================================
    // Helpers básicos - 14ABR2026
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isImageCreateOrUpdate() {
      return request.resource != null
        && (
          request.resource.contentType == 'image/jpeg'
          || request.resource.contentType == 'image/jpg'
          || request.resource.contentType == 'image/png'
          || request.resource.contentType == 'image/webp'
        )
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024;
    }

    function hasPhotoUploadReservationId() {
      return request.resource != null
        && request.resource.metadata != null
        && request.resource.metadata.keys().hasAny(['mediaPhotoReservationId'])
        && request.resource.metadata.mediaPhotoReservationId is string
        && request.resource.metadata.mediaPhotoReservationId.size() > 0
        && request.resource.metadata.mediaPhotoReservationId.size() <= 128;
    }

    function photoUploadReservation() {
      return firestore.get(
        /databases/(default)/documents/media_photo_upload_reservations/$(request.resource.metadata.mediaPhotoReservationId)
      ).data;
    }

    function hasActivePhotoUploadReservation(uid, objectPath) {
      return hasPhotoUploadReservationId()
        && photoUploadReservation().ownerUid == uid
        && photoUploadReservation().storagePath == objectPath
        && photoUploadReservation().sizeBytes == request.resource.size
        && photoUploadReservation().contentType == request.resource.contentType
        && photoUploadReservation().expiresAt > request.time;
    }

    function isVideoCreateOrUpdate() {
      return request.resource != null
        && (
          request.resource.contentType == 'video/mp4'
          || request.resource.contentType == 'video/x-m4v'
          || request.resource.contentType == 'video/quicktime'
          || request.resource.contentType == 'video/webm'
          || request.resource.contentType == 'video/x-matroska'
          || request.resource.contentType == 'video/x-msvideo'
          || request.resource.contentType == 'video/avi'
          || request.resource.contentType == 'video/msvideo'
          || request.resource.contentType == 'video/x-ms-wmv'
          || request.resource.contentType == 'video/mp2t'
          || request.resource.contentType == 'application/mxf'
          || request.resource.contentType == 'video/mxf'
        )
        && request.resource.size > 0;
    }

    function hasVideoUploadReservationId() {
      return request.resource != null
        && request.resource.metadata != null
        && request.resource.metadata.keys().hasAny(['mediaVideoReservationId'])
        && request.resource.metadata.mediaVideoReservationId is string
        && request.resource.metadata.mediaVideoReservationId.size() > 0
        && request.resource.metadata.mediaVideoReservationId.size() <= 128;
    }

    function videoUploadReservation() {
      return firestore.get(
        /databases/(default)/documents/media_video_upload_reservations/$(request.resource.metadata.mediaVideoReservationId)
      ).data;
    }

    function hasActiveVideoUploadReservation(uid, objectPath) {
      return hasVideoUploadReservationId()
        && videoUploadReservation().ownerUid == uid
        && videoUploadReservation().videoStoragePath == objectPath
        && videoUploadReservation().videoSizeBytes == request.resource.size
        && videoUploadReservation().videoContentType == request.resource.contentType
        && videoUploadReservation().expiresAt > request.time;
    }

    function hasActiveVideoPosterReservation(uid, videoId, objectPath) {
      return hasVideoUploadReservationId()
        && videoUploadReservation().ownerUid == uid
        && videoUploadReservation().videoId == videoId
        && videoUploadReservation().posterStoragePath == objectPath
        && videoUploadReservation().posterSizeBytes == request.resource.size
        && videoUploadReservation().posterContentType == request.resource.contentType
        && videoUploadReservation().expiresAt > request.time;
    }

    // ============================================================
    // Upload bruto e privado do usuário
    // - upload e rollback continuam sob controle do proprietário;
    // - reprodução usa URL temporária emitida pelo backend.
    // ============================================================

    match /users/{uid}/uploads/images/{fileName} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && isImageCreateOrUpdate()
        && hasActivePhotoUploadReservation(
          uid,
          'users/' + uid + '/uploads/images/' + fileName
        );
      allow delete: if isSelf(uid);
    }

    match /users/{uid}/uploads/videos/{fileName} {
      allow read: if false;
      allow create, update: if isSelf(uid)
        && isVideoCreateOrUpdate()
        && hasActiveVideoUploadReservation(
          uid,
          'users/' + uid + '/uploads/videos/' + fileName
        );
      allow delete: if isSelf(uid);
    }

    // Poster gerado localmente para um vídeo privado específico.
    // O namespace separado permite limpeza segura junto do vídeo sem afetar fotos.
    match /users/{uid}/uploads/video-posters/{videoId}/{fileName} {
      allow read: if false;
      allow create, update: if isSelf(uid)
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && hasActiveVideoPosterReservation(
          uid,
          videoId,
          'users/' + uid + '/uploads/video-posters/' + videoId + '/' + fileName
        );
      allow delete: if isSelf(uid);
    }

    // Derivados produzidos exclusivamente pelo backend.
    // Reprodução também ocorre somente por URL temporária emitida pelo backend.
    match /users/{uid}/processed/videos/{videoId}/{allPaths=**} {
      allow read, write: if false;
    }

    // Acesso direto a avatares acompanha a autoridade canônica da conta.
    // Não confundir esta regra com URLs Firebase de download com token,
    // que precisam de política própria de emissão/revogação.
    function userDocument(uid) {
      return /databases/(default)/documents/users/$(uid);
    }

    function userDataOrNull(uid) {
      let path = userDocument(uid);
      return firestore.exists(path) ? firestore.get(path).data : null;
    }

    function activeAccountForAvatar(uid) {
      let user = userDataOrNull(uid);
      return user != null
        && user.get('accountStatus', 'active') == 'active'
        && user.get('suspended', false) != true
        && user.get('accountLocked', false) != true
        && user.get('loginAllowed', true) != false
        && user.get('interactionBlocked', false) != true;
    }

    function avatarOwnerExposable(uid) {
      let user = userDataOrNull(uid);
      return activeAccountForAvatar(uid)
        && user.get('publicVisibility', 'visible') == 'visible';
    }

    function activeBlock(blockerUid, targetUid) {
      let path = /databases/(default)/documents/users/$(blockerUid)/blocks/$(targetUid);
      return firestore.exists(path)
        && firestore.get(path).data.get('isBlocked', false) == true;
    }

    function mayReadPublishedAvatar(uid) {
      return isSelf(uid)
        || (
          signedIn()
          && activeAccountForAvatar(request.auth.uid)
          && avatarOwnerExposable(uid)
          && !activeBlock(uid, request.auth.uid)
          && !activeBlock(request.auth.uid, uid)
        );
    }

    // ============================================================
    // Avatar publicado
    // ============================================================

    match /users/{uid}/published/avatar/{fileName} {
      allow read: if mayReadPublishedAvatar(uid);
      allow create, update: if isSelf(uid) && isImageCreateOrUpdate();
      allow delete: if isSelf(uid);
    }

    // ============================================================
    // Mídia publicada sensível
    // - leitura ocorre somente por URL temporária emitida pelo backend;
    // - clientes não acessam nem escrevem diretamente estes namespaces.
    // ============================================================

    match /users/{uid}/published/images/{allPaths=**} {
      allow read, write: if false;
    }

    match /users/{uid}/published/videos/{allPaths=**} {
      allow read, write: if false;
    }

    // ============================================================
    // Área técnica / sistema / derivados
    // ============================================================

    match /system/{allPaths=**} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
