rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ============================================================
    // Helpers básicos - 14ABR2026
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isImageCreateOrUpdate() {
      return request.resource != null
        && request.resource.contentType.matches('image/.*')
        && request.resource.size <= 10 * 1024 * 1024;
    }

    function isVideoCreateOrUpdate() {
      return request.resource != null
        && (
          request.resource.contentType == 'video/mp4'
          || request.resource.contentType == 'video/webm'
          || request.resource.contentType == 'video/quicktime'
        )
        && request.resource.size <= 500 * 1024 * 1024;
    }

    function isCaptionCreateOrUpdate(fileName) {
      return request.resource != null
        && fileName.matches('.*[.]vtt')
        && request.resource.contentType == 'text/vtt'
        && request.resource.size <= 1024 * 1024;
    }

    function isPhotoSourceSlot(slot) {
      return slot == 'source-a' || slot == 'source-b';
    }

    function registeredPhotoExists(uid, photoId) {
      return firestore.exists(
        /databases/(default)/documents/users/$(uid)/photos/$(photoId)
      );
    }

    // ============================================================
    // Staging técnico do usuário
    // - não existe biblioteca privada para novos uploads;
    // - cada foto possui somente dois slots fixos para copy-on-write;
    // - leitura só é liberada depois que o backend registra a publicação;
    // - objetos abandonados são removidos pela limpeza agendada.
    // ============================================================

    // Compatibilidade de leitura/exclusão para fotos legadas. Novos objetos não
    // podem mais ser criados no namespace plano ilimitado.
    match /users/{uid}/uploads/images/{fileName} {
      allow read: if isSelf(uid);
      allow create, update: if false;
      allow delete: if isSelf(uid);
    }

    match /users/{uid}/uploads/images/{photoId}/{slot} {
      allow read: if isSelf(uid)
        && isPhotoSourceSlot(slot)
        && registeredPhotoExists(uid, photoId);
      allow create, update: if isSelf(uid)
        && isPhotoSourceSlot(slot)
        && isImageCreateOrUpdate();
      allow delete: if isSelf(uid) && isPhotoSourceSlot(slot);
    }

    match /users/{uid}/uploads/videos/{fileName} {
      allow read: if false;
      allow create, update: if isSelf(uid) && isVideoCreateOrUpdate();
      allow delete: if isSelf(uid);
    }

    // Poster gerado localmente para um vídeo privado específico.
    // O namespace separado permite limpeza segura junto do vídeo sem afetar fotos.
    match /users/{uid}/uploads/video-posters/{videoId}/{fileName} {
      allow read: if false;
      allow create, update: if isSelf(uid) && isImageCreateOrUpdate();
      allow delete: if isSelf(uid);
    }

    // Legendas WebVTT permanecem privadas e só são lidas por URL temporária
    // emitida após nova validação da publicação e da audiência.
    match /users/{uid}/uploads/video-captions/{videoId}/{fileName} {
      allow read: if false;
      allow create, update: if isSelf(uid)
        && isCaptionCreateOrUpdate(fileName);
      allow delete: if isSelf(uid);
    }

    // Derivados produzidos exclusivamente pelo backend.
    // Reprodução também ocorre somente por URL temporária emitida pelo backend.
    match /users/{uid}/processed/videos/{videoId}/{allPaths=**} {
      allow read, write: if false;
    }

    // ============================================================
    // Avatar publicado
    // ============================================================

    match /users/{uid}/published/avatar/{fileName} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid) && isImageCreateOrUpdate();
      allow delete: if isSelf(uid);
    }

    // ============================================================
    // Mídia publicada sensível
    // - leitura ocorre somente por URL temporária emitida pelo backend;
    // - clientes não acessam nem escrevem diretamente estes namespaces.
    // ============================================================

    match /users/{uid}/published/images/{allPaths=**} {
      allow read, write: if false;
    }

    match /users/{uid}/published/videos/{allPaths=**} {
      allow read, write: if false;
    }

    // ============================================================
    // Área técnica / sistema / derivados
    // ============================================================

    match /system/{allPaths=**} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
