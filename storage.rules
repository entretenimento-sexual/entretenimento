rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ============================================================
    // Helpers básicos - 02AGO2026
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isImageCreateOrUpdate() {
      return request.resource != null
        && request.resource.contentType.matches('image/.*')
        && request.resource.size <= 10 * 1024 * 1024;
    }

    function isVideoCreateOrUpdate() {
      return request.resource != null
        && (
          request.resource.contentType == 'video/mp4'
          || request.resource.contentType == 'video/webm'
          || request.resource.contentType == 'video/quicktime'
        )
        && request.resource.size <= 500 * 1024 * 1024;
    }

    function privateMediaUser(uid) {
      return firestore.get(
        /databases/(default)/documents/users/$(uid)
      ).data;
    }

    function hasVerifiedEmail(user) {
      return (
          'email_verified' in request.auth.token
          && request.auth.token.email_verified == true
        )
        || (
          'emailVerified' in user
          && user.emailVerified == true
        );
    }

    function hasOperationalPrivateMediaAccount(uid) {
      let user = privateMediaUser(uid);
      return user.uid == uid
        && (!('accountStatus' in user) || user.accountStatus == 'active')
        && (!('suspended' in user) || user.suspended != true)
        && (!('interactionBlocked' in user) || user.interactionBlocked != true)
        && (!('accountLocked' in user) || user.accountLocked != true)
        && (!('loginAllowed' in user) || user.loginAllowed != false)
        && hasVerifiedEmail(user)
        && user.profileCompleted == true
        && (!('idade' in user) || !(user.idade is number) || user.idade >= 18)
        && (!('age' in user) || !(user.age is number) || user.age >= 18)
        && (
          !('ageReverification' in user)
          || (
            user.ageReverification is map
            && (
              !('result' in user.ageReverification)
              || user.ageReverification.result != 'UNDERAGE'
            )
            && (
              !('status' in user.ageReverification)
              || (
                user.ageReverification.status != 'REQUIRED'
                && user.ageReverification.status != 'SUBMITTED'
                && user.ageReverification.status != 'UNDER_REVIEW'
                && user.ageReverification.status != 'REJECTED'
                && user.ageReverification.status != 'EXPIRED'
              )
            )
          )
        )
        && (
          !('adultConsent' in user)
          || (
            user.adultConsent is map
            && (
              !('accepted' in user.adultConsent)
              || user.adultConsent.accepted != false
            )
          )
        )
        && (
          !('acceptedTerms' in user)
          || (
            user.acceptedTerms is map
            && (
              !('accepted' in user.acceptedTerms)
              || user.acceptedTerms.accepted != false
            )
            && (
              !('adultAccessAcknowledgement' in user.acceptedTerms)
              || user.acceptedTerms.adultAccessAcknowledgement != false
            )
          )
        )
        && (
          !('initialAdultConsentRequired' in user)
          || user.initialAdultConsentRequired != true
          || (
            'adultConsent' in user
            && user.adultConsent is map
            && user.adultConsent.accepted == true
            && 'acceptedTerms' in user
            && user.acceptedTerms is map
            && user.acceptedTerms.accepted == true
          )
        );
    }

    function hasUploadReservationId() {
      return request.resource != null
        && request.resource.metadata != null
        && request.resource.metadata.mediaReservationId is string
        && request.resource.metadata.mediaReservationId.size() > 0
        && request.resource.metadata.mediaReservationId.size() <= 128;
    }

    function uploadReservation() {
      return firestore.get(
        /databases/(default)/documents/media_private_upload_reservations/$(request.resource.metadata.mediaReservationId)
      ).data;
    }

    function activeReservationFor(uid, kind) {
      let reservation = uploadReservation();
      return hasUploadReservationId()
        && hasOperationalPrivateMediaAccount(uid)
        && reservation.ownerUid == uid
        && reservation.kind == kind
        && reservation.state == 'ACTIVE'
        && reservation.expiresAt > request.time;
    }

    function reservedSourceUpload(uid, kind, objectPath) {
      let reservation = uploadReservation();
      return activeReservationFor(uid, kind)
        && reservation.sourceStoragePath == objectPath
        && reservation.sourceSizeBytes == request.resource.size;
    }

    function reservedAuxiliaryUpload(uid, objectPath) {
      let reservation = uploadReservation();
      return activeReservationFor(uid, 'video')
        && reservation.auxiliaryStoragePath == objectPath
        && reservation.auxiliarySizeBytes == request.resource.size;
    }

    // ============================================================
    // Upload bruto e privado do usuário
    // - toda criação exige reserva de quota vigente no Firestore;
    // - a conta precisa permanecer operacional e elegível;
    // - rollback e exclusão continuam disponíveis ao proprietário;
    // - reprodução usa URL temporária emitida pelo backend.
    // ============================================================

    match /users/{uid}/uploads/images/{fileName} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && isImageCreateOrUpdate()
        && reservedSourceUpload(
          uid,
          'photo',
          'users/' + uid + '/uploads/images/' + fileName
        );
      allow delete: if isSelf(uid);
    }

    match /users/{uid}/uploads/videos/{fileName} {
      allow read: if false;
      allow create, update: if isSelf(uid)
        && isVideoCreateOrUpdate()
        && reservedSourceUpload(
          uid,
          'video',
          'users/' + uid + '/uploads/videos/' + fileName
        );
      allow delete: if isSelf(uid);
    }

    // Poster gerado localmente para um vídeo privado específico.
    match /users/{uid}/uploads/video-posters/{videoId}/{fileName} {
      allow read: if false;
      allow create, update: if isSelf(uid)
        && isImageCreateOrUpdate()
        && reservedAuxiliaryUpload(
          uid,
          'users/' + uid + '/uploads/video-posters/' + videoId + '/' + fileName
        );
      allow delete: if isSelf(uid);
    }

    // Derivados produzidos exclusivamente pelo backend.
    // Reprodução também ocorre somente por URL temporária emitida pelo backend.
    match /users/{uid}/processed/videos/{videoId}/{allPaths=**} {
      allow read, write: if false;
    }

    // ============================================================
    // Avatar publicado
    // ============================================================

    match /users/{uid}/published/avatar/{fileName} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid) && isImageCreateOrUpdate();
      allow delete: if isSelf(uid);
    }

    // ============================================================
    // Mídia publicada sensível
    // ============================================================

    match /users/{uid}/published/images/{allPaths=**} {
      allow read, write: if false;
    }

    match /users/{uid}/published/videos/{allPaths=**} {
      allow read, write: if false;
    }

    // ============================================================
    // Área técnica / sistema / derivados
    // ============================================================

    match /system/{allPaths=**} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
