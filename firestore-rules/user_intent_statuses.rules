// firestore-rules/user_intent_statuses.rules
// ============================================================================
// USER INTENT STATUSES / STATUS DE HOJE
// ============================================================================
// Status temporário de disponibilidade/intenção do usuário.
//
// Segurança:
// - leitura pública do app exige login e status ativo/visível;
// - o usuário pode ler o próprio documento current_{uid}, inclusive vazio;
// - escrita comum direta é bloqueada;
// - publicação/ocultação devem passar pelas Cloud Functions;
// - expiração máxima e snapshots públicos são definidos pelo backend.
// ============================================================================
match /user_intent_statuses/{statusId} {
  function isCurrentStatusPath() {
    return signedIn() && statusId == ("current_" + uid());
  }

  function isOwnerStatus() {
    return signedIn() && resource.data.uid == uid();
  }

  function isDiscoverableStatus() {
    return resource.data.uid is string
      && resource.data.moderation.state == "active"
      && resource.data.visibility == "public_discovery";
  }

  function targetLifecycleAllowsExposure() {
    return resource.data.uid is string
      && canonicalOwnerLifecycleAllowsPublicMediaExposure(resource.data.uid);
  }

  allow get: if isCurrentStatusPath()
    || (
      currentUserCanUseAdultSocialPlatform()
      && (
        isOwnerStatus()
        || (
          isDiscoverableStatus()
          && targetLifecycleAllowsExposure()
        )
      )
    );

  // Enumeração client-side encerrada. As listagens públicas atravessam
  // getUserIntentStatuses, que aplica relógio, lifecycle e moderação no backend.
  allow list: if false;

  allow create, update, delete: if false;
}
