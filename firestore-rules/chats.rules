    // =======================================================================
    // CHATS DIRETOS
    // ✅ ARQUIVO MODULAR: NÃO pode ter `rules_version` nem
    //    `service cloud.firestore`
    //
    // Segurança desta versão:
    // - leitura fica restrita aos participantes com e-mail verificado;
    // - criação de chat direto ocorre somente por Cloud Function confiável;
    // - atualização do documento de chat ocorre somente por backend confiável;
    // - criação de mensagens diretas ocorre somente por Cloud Function;
    // - cliente pode atualizar exclusivamente recibos de mensagens recebidas,
    //   respeitando transição progressiva de status;
    // - cliente pode alterar somente a própria reação em reactionsByUser.
    //
    // Supressões explícitas:
    // - removida criação client-side de chats;
    // - removida atualização client-side de lastMessage,
    //   otherParticipantDetails e timestamp;
    // - removida criação client-side de mensagens diretas.
    // =======================================================================
match /chats/{chatId} {
  function canUseDirectChat(chat) {
    let participants = chat is map ? chat.get("participants", null) : null;
    return hasVerifiedEmail()
      && currentUserCanUseAdultSocialPlatform()
      && participants is list
      && participants.size() == 2
      && (uid() in participants)
      && bilateralExposureAllows(
        participants[0] == uid() ? participants[1] : participants[0]
      );
  }

  /**
   * Permite ao cliente ler somente conversas das quais participa.
   *
   * A consulta do frontend já utiliza:
   * where('participants', 'array-contains', uid)
   */
  allow read: if canUseDirectChat(resource.data);

  /**
   * Criação e alteração estrutural de chat direto permanecem exclusivas
   * das Cloud Functions confiáveis.
   */
  allow create, update, delete: if false;

    match /messages/{messageId} {
      function chatExists() {
        return exists(/databases/$(database)/documents/chats/$(chatId));
      }

      function isChatParticipantByChat() {
        let chat = chatExists()
          ? get(/databases/$(database)/documents/chats/$(chatId)).data
          : null;
        return canUseDirectChat(chat);
      }

      function isMessageReceivedByCurrentUser() {
        let data = resource.data;
        let senderId = data.get("senderId", null);
        let senderUid = data.get("senderUid", null);
        let sender = data.get("senderId", senderUid);
        let chat = get(/databases/$(database)/documents/chats/$(chatId)).data;
        return sender is string
          && sender.size() > 0
          && sender != uid()
          && sender in chat.participants
          && (!data.keys().hasAny(["senderId"]) || senderId == sender)
          && (!data.keys().hasAny(["senderUid"]) || senderUid == sender)
          && (!data.keys().hasAny(["recipientUid"]) || data.recipientUid == uid());
      }

      function isForwardReceiptTransition() {
        return (
          resource.data.status == "sent"
          && request.resource.data.status == "delivered"
        )
        || (
          resource.data.status == "delivered"
          && request.resource.data.status == "read"
        );
      }

      function hasOnlyReactionFieldChanged() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "reactionsByUser"
        ]);
      }

      function hasValidReactionValue() {
        return !(uid() in request.resource.data.reactionsByUser)
          || request.resource.data.reactionsByUser[uid()] in [
            "❤️",
            "😂",
            "🔥",
            "👀"
          ];
      }

      function changesOnlyOwnReaction() {
        return request.resource.data.reactionsByUser is map
          && (
            (
              !resource.data.keys().hasAny(["reactionsByUser"])
              && request.resource.data.reactionsByUser.keys().hasOnly([uid()])
            )
            || (
              resource.data.keys().hasAny(["reactionsByUser"])
              && request.resource.data.reactionsByUser
                .diff(resource.data.reactionsByUser)
                .affectedKeys()
                .hasOnly([uid()])
            )
          );
      }

      function isReactionUpdate() {
        return resource.data.get("deleted", false) != true
          && request.resource.data.get("deleted", false) != true
          && hasOnlyReactionFieldChanged()
          && changesOnlyOwnReaction()
          && hasValidReactionValue();
      }

      /**
       * Leitura permanece disponível somente a participantes do chat.
       */
      allow read: if isChatParticipantByChat();

      /**
       * Mensagens diretas novas são gravadas apenas por sendDirectMessage.
       */
      allow create: if false;

      // As duas modalidades de update passam por uma única autorização.
      // Rejeita primeiro alterações de campos não previstos e só depois
      // consulta lifecycle, participantes e bloqueio bilateral.
      function isReceiptUpdate() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status"
          ])
          && request.resource.data.diff(resource.data).affectedKeys().hasAll([
            "status"
          ])
          && isMessageReceivedByCurrentUser()
          && isForwardReceiptTransition();
      }

      function isPermittedMessageMutation() {
        return resource.data.get("deleted", false) != true
          && request.resource.data.get("deleted", false) != true
          && (isReceiptUpdate() || isReactionUpdate());
      }

      // Escrita estrutural e criação continuam backend-only.
      // A autorização relacional é executada uma vez por atualização.
      allow update: if isPermittedMessageMutation()
        && isChatParticipantByChat();

      allow delete: if false;
    }
}

// CHAT-R1.2: internal discovery candidates are not an authorization grant.
// Client access stays closed until lifecycle, revocation and migration are validated.
match /direct_chat_discovery/{ownerUid}/chats/{chatId} {
  allow read, write: if false;
}

// CHAT-R1.6: only the opaque revision document, never the candidate subcollection.
match /direct_chat_discovery/{ownerUid} {
  allow get: if hasVerifiedEmail() && isSelf(ownerUid)
    && currentUserCanUseAdultSocialPlatform();
  allow list, create, update, delete: if false;
}
