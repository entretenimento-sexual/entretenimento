// ===============================================================
//              firestore-rules/_helpers.rules
// ===============================================================
// Objetivo:
// - Centralizar helpers de autenticação, lifecycle, claims e tipos;
// - Evitar interpretações diferentes de conta operacional entre módulos;
// - Padronizar timestamps aceitando timestamp real ou serverTimestamp().
// ===============================================================
// Este arquivo abre service e match /databases/... e não fecha. O fechamento
// continua no _footer.rules.
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Auth helpers
    // ===============================================================
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isSelf(userId) { return signedIn() && uid() == userId; }

    // ===============================================================
    // Lifecycle operacional
    // ===============================================================
    function accountLifecycleIsOperational(user) {
      return (!user.keys().hasAny(["accountStatus"])
          || user.accountStatus == "active")
        && (!user.keys().hasAny(["suspended"])
          || user.suspended != true)
        && (!user.keys().hasAny(["interactionBlocked"])
          || user.interactionBlocked != true)
        && (!user.keys().hasAny(["accountLocked"])
          || user.accountLocked != true)
        && (!user.keys().hasAny(["loginAllowed"])
          || user.loginAllowed != false)
        && (
          !user.keys().hasAny(["ageReverification"])
          || !(user.ageReverification is map)
          || !user.ageReverification.keys().hasAny(["status"])
          || (
            user.ageReverification.status != "REQUIRED"
            && user.ageReverification.status != "SUBMITTED"
            && user.ageReverification.status != "UNDER_REVIEW"
            && user.ageReverification.status != "REJECTED"
            && user.ageReverification.status != "EXPIRED"
          )
        )
        && (
          !user.keys().hasAny(["ageReverification"])
          || !(user.ageReverification is map)
          || !user.ageReverification.keys().hasAny(["result"])
          || user.ageReverification.result != "UNDERAGE"
        );
    }

    function accountAdultConsentIsValid(user) {
      return !user.keys().hasAny(["initialAdultConsentRequired"])
        || user.initialAdultConsentRequired != true
        || (
          user.keys().hasAny(["adultConsent"])
          && user.adultConsent is map
          && user.adultConsent.keys().hasAny(["accepted"])
          && user.adultConsent.accepted == true
        );
    }

    function accountTermsAreValid(user) {
      return !user.keys().hasAny(["initialAdultConsentRequired"])
        || user.initialAdultConsentRequired != true
        || (
          user.keys().hasAny(["acceptedTerms"])
          && user.acceptedTerms is map
          && user.acceptedTerms.keys().hasAny(["accepted"])
          && user.acceptedTerms.accepted == true
          && (
            !user.acceptedTerms.keys().hasAny([
              "adultAccessAcknowledgement"
            ])
            || user.acceptedTerms.adultAccessAcknowledgement != false
          )
        );
    }

    function operationalAccountProjectionIsValid(user, userId) {
      return (!user.keys().hasAny(["uid"]) || user.uid == userId)
        && accountLifecycleIsOperational(user)
        && accountAdultConsentIsValid(user)
        && accountTermsAreValid(user);
    }

    function isOperationalAccount(userId) {
      let userPath = /databases/$(database)/documents/users/$(userId);
      return signedIn()
        && exists(userPath)
        && operationalAccountProjectionIsValid(
          get(userPath).data,
          userId
        );
    }

    function isOperationalMediaAccount(userId) {
      let userPath = /databases/$(database)/documents/users/$(userId);
      let user = exists(userPath) ? get(userPath).data : {};
      return isSelf(userId)
        && exists(userPath)
        && operationalAccountProjectionIsValid(user, userId)
        && request.auth.token.keys().hasAny(["email_verified"])
        && request.auth.token.email_verified == true
        && user.keys().hasAny(["profileCompleted"])
        && user.profileCompleted == true;
    }

    // ===============================================================
    // Assinatura
    // ===============================================================
    // Entitlements são a verdade financeira e permanecem fechados ao cliente.
    // users/{uid} contém somente uma projeção operacional, escrita pelo backend.
    function activeSubscriptionProjectionIsValid(user) {
      return user.keys().hasAll([
          "billingProjectionVersion",
          "isSubscriber",
          "subscriptionStatus",
          "subscriptionScope",
          "subscriptionStartedAt",
          "subscriptionEndsAt"
        ])
        && user.billingProjectionVersion == 1
        && user.isSubscriber == true
        && user.subscriptionStatus == "active"
        && user.subscriptionScope == "platform_subscription"
        && user.subscriptionStartedAt is timestamp
        && user.subscriptionEndsAt is timestamp
        && user.subscriptionStartedAt <= request.time
        && request.time < user.subscriptionEndsAt;
    }

    function subscriptionRoleFromProjection(user) {
      return user.keys().hasAny(["tier"])
        ? user.tier
        : user.keys().hasAny(["role"])
          ? user.role
          : null;
    }

    function subscriptionRoleRank(role) {
      return role == "basic"
        ? 1
        : role == "premium"
          ? 2
          : role == "vip"
            ? 3
            : 0;
    }

    function activeSubscriptionRankFromProjection(user) {
      return activeSubscriptionProjectionIsValid(user)
        ? subscriptionRoleRank(subscriptionRoleFromProjection(user))
        : 0;
    }

    function activeSubscriptionRank(userId) {
      let userPath = /databases/$(database)/documents/users/$(userId);
      return signedIn() && exists(userPath)
        ? activeSubscriptionRankFromProjection(get(userPath).data)
        : 0;
    }

    function isActiveSubscriber(userId) {
      return activeSubscriptionRank(userId) > 0;
    }

    function activeSubscriptionRole(userId) {
      let userPath = /databases/$(database)/documents/users/$(userId);
      return signedIn() && exists(userPath)
        ? subscriptionRoleFromProjection(get(userPath).data)
        : null;
    }

    function hasMinimumActiveSubscriptionRole(userId, minimumRole) {
      return activeSubscriptionRank(userId) >= subscriptionRoleRank(minimumRole);
    }

    // ===============================================================
    // Timestamp helpers
    // ===============================================================
    function isServerTime(v) { return v == request.time; }
    function isTs(v) { return (v is timestamp) || isServerTime(v); }

    // ===============================================================
    // Claims helpers
    // ===============================================================
    function hasClaim(k) {
      return signedIn()
        && request.auth.token.keys().hasAny([k])
        && request.auth.token[k] == true;
    }

    function isAdmin() { return hasClaim("admin"); }

    // ===============================================================
    // Optional fields helpers
    // ===============================================================
    function hasReqField(k) {
      return request.resource.data.keys().hasAny([k]);
    }

    function optString(k) {
      return !hasReqField(k)
        || request.resource.data[k] == null
        || request.resource.data[k] is string;
    }

    function optNumberOrNull(k) {
      return !hasReqField(k)
        || request.resource.data[k] == null
        || request.resource.data[k] is number;
    }

    function optTimestamp(k) {
      return !hasReqField(k)
        || request.resource.data[k] == null
        || isTs(request.resource.data[k]);
    }
    // Os demais matches entram abaixo via build.
// ===============================================================
//             Fim do firestore-rules/_helpers.rules
// ===============================================================
