// =========================================================================
// USERS / blocks (privado) + events (auditoria)
// ✅ ARQUIVO MODULAR: NÃO pode ter `rules_version` nem `service cloud.firestore`
// uso de helpers globais
// firestore-rules/users_blocks.rules
// =========================================================================

match /users/{ownerUid}/blocks/{targetUid} {
  // O cliente pode consultar apenas sua própria lista de bloqueios.
  // Estado e auditoria são alterados exclusivamente pelas Cloud Functions.
  allow get, list: if isSelf(ownerUid);
  allow create, update, delete: if false;

  match /events/{eventId} {
    allow get, list: if isSelf(ownerUid);
    allow create, update, delete: if false;
  }
}


// Projeção privada e derivada da disponibilidade bilateral da conversa.
// Cliente consulta somente seu próprio estado, sem identificar bloqueador.
// Criação e mutação são estritamente backend-only. A ausência da projeção
// não autoriza interações: Rules e Cloud Functions mantêm a autoridade.
match /direct_chat_access/{ownerUid}/peers/{peerUid} {
  allow get: if isSelf(ownerUid);
  allow list, create, update, delete: if false;
}
