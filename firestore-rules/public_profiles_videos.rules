// ===============================================================
// PUBLIC_PROFILES / public_videos
// ===============================================================

match /public_profiles/{userId}/public_videos/{videoId} {

  function publicProfilePath() {
    return /databases/$(database)/documents/public_profiles/$(userId);
  }

  function publicProfileExists() {
    return exists(publicProfilePath());
  }

  function videoPath() {
    return /databases/$(database)/documents/public_profiles/$(userId)/public_videos/$(videoId);
  }

  function videoExists() {
    return exists(videoPath());
  }

  function videoData() {
    return get(videoPath()).data;
  }

  function blockPath(blockerUid, targetUid) {
    return /databases/$(database)/documents/users/$(blockerUid)/blocks/$(targetUid);
  }

  function hasActiveBlock(blockerUid, targetUid) {
    return exists(blockPath(blockerUid, targetUid))
      && get(blockPath(blockerUid, targetUid)).data.isBlocked == true;
  }

  function isBlockedBetween(viewerUid, ownerUid) {
    return viewerUid != ownerUid
      && (
        hasActiveBlock(viewerUid, ownerUid)
        || hasActiveBlock(ownerUid, viewerUid)
      );
  }

  function isApprovedPublicVideoData(data) {
    return data.visibility == "PUBLIC"
      && data.moderationStatus == "APPROVED";
  }

  // SUPRESSÃO INTENCIONAL DA LEITURA DIRETA PARA TERCEIROS:
  // a projeção contém metadados adultos e Firestore Rules não conseguem aplicar
  // filtros dinâmicos de lifecycle, bloqueio e futura audiência financeira em
  // consultas. Perfil e ranking usam callables backend autorizadas.
  allow get, list: if signedIn() && isSelf(userId);

  allow create, update, delete: if false;

  match /likes/{viewerUid} {
    allow get: if signedIn()
      && request.auth.uid == viewerUid
      && !isBlockedBetween(request.auth.uid, userId);
    allow list: if false;
    allow create, update, delete: if false;
  }

  match /ratings/{viewerUid} {
    allow get: if signedIn()
      && request.auth.uid == viewerUid
      && !isBlockedBetween(request.auth.uid, userId);
    allow list: if false;
    allow create, update, delete: if false;
  }

  match /comments/{commentId} {
    allow get: if signedIn()
      && (
        isSelf(userId)
        || (
          publicProfileExists()
          && !isBlockedBetween(request.auth.uid, userId)
          && resource.data.status == "VISIBLE"
          && videoExists()
          && isApprovedPublicVideoData(videoData())
        )
      );

    allow list: if signedIn()
      && (
        isSelf(userId)
        || (
          publicProfileExists()
          && !isBlockedBetween(request.auth.uid, userId)
          && resource.data.status == "VISIBLE"
          && videoExists()
          && isApprovedPublicVideoData(videoData())
        )
      );

    allow create, update, delete: if false;
  }
}

// ------------------------------------------------------------
// Collection group: public_videos
// ------------------------------------------------------------
// SUPRESSÃO INTENCIONAL DO ACESSO DIRETO GLOBAL:
// Firestore Rules não funcionam como filtro por bloqueio. Ranking e descoberta
// são servidos por listAuthorizedPublicVideos, que valida as duas fontes
// canônicas e a política de audiência antes de devolver metadados.
match /{path=**}/public_videos/{videoId} {
  allow list: if false;

  allow create, update, delete: if false;
}

// ==============================================================
//           FIM DO PUBLIC_PROFILES_VIDEOS.RULES
// ==============================================================
