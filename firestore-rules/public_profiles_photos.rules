// firestore-rules/public_profiles_photos.rules
// ===============================================================
// PUBLIC_PROFILES / public_photos
// - Metadados de terceiros são servidos por callables autorizadas.
// - Leitura direta permanece apenas para o próprio autor operacional.
// - Comentários respeitam lifecycle, existência do perfil e bloqueio bilateral.
// ===============================================================

match /public_profiles/{userId}/public_photos/{photoId} {

  function publicProfilePath() {
    return /databases/$(database)/documents/public_profiles/$(userId);
  }

  function publicProfileExists() {
    return exists(publicProfilePath());
  }

  function photoPath() {
    return /databases/$(database)/documents/public_profiles/$(userId)/public_photos/$(photoId);
  }

  function photoExists() {
    return exists(photoPath());
  }

  function photoData() {
    return get(photoPath()).data;
  }

  function blockPath(blockerUid, targetUid) {
    return /databases/$(database)/documents/users/$(blockerUid)/blocks/$(targetUid);
  }

  function hasActiveBlock(blockerUid, targetUid) {
    return exists(blockPath(blockerUid, targetUid))
      && get(blockPath(blockerUid, targetUid)).data.isBlocked == true;
  }

  function isBlockedBetween(viewerUid, ownerUid) {
    return viewerUid != ownerUid
      && (
        hasActiveBlock(viewerUid, ownerUid)
        || hasActiveBlock(ownerUid, viewerUid)
      );
  }

  function isApprovedPublicPhotoData(data) {
    return data.visibility == "PUBLIC"
      && data.moderationStatus == "APPROVED";
  }

  // SUPRESSÃO INTENCIONAL DA LEITURA DIRETA PARA TERCEIROS:
  // Firestore Rules não filtram lifecycle e bloqueio de forma segura em
  // consultas globais. Feed e perfil usam listAuthorized*Photos.
  allow get, list: if isOperationalMediaAccount(userId);

  allow create, update, delete: if false;

  match /likes/{viewerUid} {
    allow get: if signedIn()
      && request.auth.uid == viewerUid
      && isOperationalAccount(request.auth.uid)
      && !isBlockedBetween(request.auth.uid, userId);
    allow list: if false;
    allow create, update, delete: if false;
  }

  match /comments/{commentId} {
    allow get, list: if signedIn()
      && isOperationalAccount(request.auth.uid)
      && (
        isSelf(userId)
        || (
          publicProfileExists()
          && !isBlockedBetween(request.auth.uid, userId)
          && resource.data.status == "VISIBLE"
          && photoExists()
          && isApprovedPublicPhotoData(photoData())
        )
      );

    allow create, update, delete: if false;
  }
}

// Metadados globais são servidos exclusivamente por backend autorizado.
match /{path=**}/public_photos/{photoId} {
  allow list: if false;
  allow create, update, delete: if false;
}

// ==============================================================
//           FIM DO PUBLIC_PROFILES_PHOTOS.RULES
// ==============================================================
