// firestore-rules/public_profiles_photos.rules
// ===============================================================
// PUBLIC_PROFILES / public_photos
// ===============================================================

match /public_profiles/{userId}/public_photos/{photoId} {

  function publicProfilePath() {
    return /databases/$(database)/documents/public_profiles/$(userId);
  }

  function publicProfileExists() {
    return exists(publicProfilePath());
  }
  function publicProfileAllowsAdultExposure() {
    return publicProfileExists()
      && canonicalOwnerLifecycleAllowsPublicMediaExposure(userId);
  }

  function photoPath() {
    return /databases/$(database)/documents/public_profiles/$(userId)/public_photos/$(photoId);
  }

  function photoExists() {
    return exists(photoPath());
  }

  function photoData() {
    return get(photoPath()).data;
  }

  function viewerFriendPath() {
    return /databases/$(database)/documents/users/$(request.auth.uid)/friends/$(userId);
  }

  function ownerFriendPath() {
    return /databases/$(database)/documents/users/$(userId)/friends/$(request.auth.uid);
  }

  function hasMutualFriendship() {
    return exists(viewerFriendPath()) && exists(ownerFriendPath());
  }

  function isApprovedPublicPhotoData(data) {
    return data.visibility == "PUBLIC"
      && data.moderationStatus == "APPROVED";
  }

  function commentPhotoAllowsAdultExposure(data) {
    return canonicalOwnerLifecycleAllowsPublicMediaExposure(userId);
  }

  function isApprovedCommentReadablePhotoData(data) {
    return commentPhotoAllowsAdultExposure(data)
      && data.moderationStatus == "APPROVED"
      && bilateralExposureAllows(userId)
      && (
        data.visibility == "PUBLIC"
        || (data.visibility == "FRIENDS" && hasMutualFriendship())
      );
  }

  function isPublicReadable() {
    return publicProfileAllowsAdultExposure()
      && bilateralExposureAllows(userId)
      && resource.data.visibility == "PUBLIC"
      && resource.data.moderationStatus == "APPROVED";
  }

  function isPublicListReadable() {
    return resource.data.visibility == "PUBLIC"
      && resource.data.moderationStatus == "APPROVED";
  }

  allow get: if canConsumeAdultPublicMedia()
    && (isSelf(userId) || isPublicReadable());

  // Galerias owner-scoped também atravessam a Callable backend-time.
  // O get direto permanece disponível para deep links sob fronteira forte.
  allow list: if false;

  allow create, update, delete: if false;

  match /likes/{viewerUid} {
    allow get: if canConsumeAdultPublicMedia()
      && bilateralExposureAllows(userId)
      && request.auth.uid == viewerUid;
    allow list: if false;
    allow create, update, delete: if false;
  }

  match /comments/{commentId} {
    allow get: if canConsumeAdultPublicMedia()
      && (
        isSelf(userId)
        || (
          resource.data.status == "VISIBLE"
          && isApprovedCommentReadablePhotoData(photoData())
        )
      );

    allow list: if canConsumeAdultPublicMedia()
      && (
        isSelf(userId)
        || (
          resource.data.status == "VISIBLE"
          && isApprovedCommentReadablePhotoData(photoData())
        )
      );

    allow create, update, delete: if false;
  }
}

// ------------------------------------------------------------
// Collection group: public_photos
// FRIENDS não é aberta nesta superfície: descoberta restrita passa
// pelo backend autorizado e por URL temporária revalidada.
// Leituras diretas permanecem no match específico acima, que também
// confirma a existência do perfil público pai.
// ------------------------------------------------------------
match /{path=**}/public_photos/{mediaId} {
  // Collection-group discovery é backend-only. Galerias de proprietário
  // conhecido continuam autorizadas pelo match específico acima.
  allow list: if false;

  allow create, update, delete: if false;
}

// ==============================================================
//           FIM DO PUBLIC_PROFILES_PHOTOS.RULES
// ==============================================================
