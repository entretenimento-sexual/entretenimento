//==============================================================================
// Regras de segurança do Firestore para a coleção canônica de amigos.
//
// Modelo de autoridade:
// - leitura: somente o proprietário da lista;
// - escrita: exclusivamente Cloud Functions/Admin SDK;
// - aceitar/desfazer amizade nunca é uma mutação client-side.
//
// ✅ ARQUIVO MODULAR: NÃO pode ter `rules_version` nem `service cloud.firestore`
// uso de helpers globais
//==============================================================================
match /users/{userId}/friends/{friendUid} {
  allow get, list: if isSelf(userId);
  allow create, update, delete: if false;
}
// ==============================================================
//                 FIM DO USERS_FRIENDS.RULES
// ==============================================================
