// firestore-rules/public_profiles_next.rules
// =========================================================================
// PUBLIC PROFILES (consultable / discovery)
// =========================================================================
// Fronteira de autorização concentrada em ownership, estado privado pós-write,
// maioridade canônica e conjunto de chaves permitido. Validações editoriais de
// formato ficam no formulário/backend para preservar o orçamento de expressões.
// =========================================================================
match /public_profiles/{userId} {
  function targetAgeProjectionAllowsAdultExposure() {
    let validUntil = resource.data.ageEligibilityValidUntil;
    return resource.data.ageEligibilityVerifiedAdult == true
      && validUntil is timestamp
      && request.time < validUntil;
  }

  function targetCanonicalAgeEligibilityAllowsAdultExposure() {
    return canonicalAgeEligibilityAllowsAdultAccess(userId);
  }

  allow get: if currentUserCanUseAdultSocialPlatform()
    && targetAgeProjectionAllowsAdultExposure()
    && targetCanonicalAgeEligibilityAllowsAdultExposure();

  allow list: if false;

  function privateUserPath() {
    return /databases/$(database)/documents/users/$(userId);
  }

  function privateUserEligibleAfter() {
    let user = getAfter(privateUserPath()).data;
    return user is map
      && user.emailVerified == true
      && user.profileCompleted == true
      && user.publicVisibility == "visible"
      && user.interactionBlocked == false
      && canonicalAgeEligibilityAllowsAdultAccess(userId)
      && adultMediaHasCurrentTerms(user)
      && adultMediaHasRequiredConsent(user);
  }

  function privateUserEligibleCurrent() {
    let user = get(privateUserPath()).data;
    return user is map
      && user.emailVerified == true
      && user.profileCompleted == true
      && user.publicVisibility == "visible"
      && user.interactionBlocked == false
      && canonicalAgeEligibilityAllowsAdultAccess(userId)
      && adultMediaHasCurrentTerms(user)
      && adultMediaHasRequiredConsent(user);
  }

  function createKeysValid() {
    return request.resource.data.keys().hasOnly([
      "uid",
      "nickname",
      "nicknameNormalized",
      "avatarUrl",
      "photoURL",
      "municipio",
      "estado",
      "gender",
      "identityCode",
      "identityCatalogVersion",
      "orientation",
      "role",
      "latitude",
      "longitude",
      "geohash",
      "createdAt",
      "updatedAt"
    ])
      && request.resource.data.keys().hasAll([
        "uid",
        "nickname",
        "nicknameNormalized",
        "municipio",
        "estado",
        "gender",
        "identityCode",
        "identityCatalogVersion",
        "orientation",
        "role",
        "createdAt",
        "updatedAt"
      ]);
  }

  function updateKeysValid() {
    return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      "nickname",
      "nicknameNormalized",
      "avatarUrl",
      "photoURL",
      "municipio",
      "estado",
      "gender",
      "identityCode",
      "identityCatalogVersion",
      "orientation",
      "latitude",
      "longitude",
      "geohash",
      "updatedAt"
    ]);
  }

  function identityMatchesPrivateDeclarationAfter() {
    let user = getAfter(privateUserPath()).data;
    let declaredCode = user.get(
      "declaredIdentityCode",
      user.get("gender", "")
    );
    let catalogVersion = user.get("identityCatalogVersion", 1);
    return request.resource.data.identityCode == declaredCode
      && request.resource.data.gender == user.get("gender", declaredCode)
      && request.resource.data.identityCatalogVersion == catalogVersion;
  }

  function identityMatchesPrivateDeclarationCurrent() {
    let user = get(privateUserPath()).data;
    let declaredCode = user.get(
      "declaredIdentityCode",
      user.get("gender", "")
    );
    let catalogVersion = user.get("identityCatalogVersion", 1);
    return request.resource.data.identityCode == declaredCode
      && request.resource.data.gender == user.get("gender", declaredCode)
      && request.resource.data.identityCatalogVersion == catalogVersion;
  }

  function identityChangeSafe() {
    let changed = request.resource.data.diff(resource.data).affectedKeys();
    let identityKeys = ["gender", "identityCode", "identityCatalogVersion"];
    return !changed.hasAny(identityKeys)
      || (
        changed.hasAll(identityKeys)
        && identityMatchesPrivateDeclarationCurrent()
      );
  }

  function avatarOnlyUpdate() {
    let changed = request.resource.data.diff(resource.data).changedKeys();
    return changed.hasOnly(["photoURL", "avatarUrl", "updatedAt"])
      && changed.hasAny(["photoURL", "avatarUrl"])
      && request.resource.data.updatedAt == request.time;
  }

  allow create: if resource == null
    && isSelf(userId)
    && createKeysValid()
    && request.resource.data.uid == uid()
    && request.resource.data.role == "free"
    && request.resource.data.createdAt == request.time
    && request.resource.data.updatedAt == request.time
    && identityMatchesPrivateDeclarationAfter()
    && privateUserEligibleAfter();

  allow update: if resource != null
    && isSelf(userId)
    && (
      avatarOnlyUpdate()
      || (
        updateKeysValid()
        && request.resource.data.uid == resource.data.uid
        && identityChangeSafe()
        && request.resource.data.updatedAt == request.time
      )
    )
    && privateUserEligibleCurrent();

  allow delete: if false;

  match /profile_viewers/{viewerUid} {
    allow read, write: if false;
  }
}
