// firestore-rules/public_profiles_next.rules
// =========================================================================
// PUBLIC PROFILES (consultable / discovery)
// =========================================================================
// Fronteira de autorização concentrada em ownership, estado privado pós-write,
// lifecycle da conta e conjunto de chaves permitido. Validações editoriais de
// formato ficam no formulário/backend para preservar o orçamento de expressões.
// =========================================================================
match /public_profiles/{userId} {

  // Documento Firestore é atômico: não há redaction por campo.
  // Perfis antigos com interesses privados precisam ser saneados antes de
  // poderem ser lidos por terceiros. O proprietário pode inspecionar o seu.
  function lacksPrivateDiscoveryInterestFields() {
    return !resource.data.keys().hasAny([
      "preferences","preferencias","interests","interesses","lookingFor","buscando",
      "discoveryPreferences","hardRules","softRules","matchingModes","selfTraits",
      "interestedInGenders","interestedInGender","targetGenders",
      "preferredGenders","generosDeInteresse",
      "interestedInOrientations","interestedInOrientation","targetOrientations",
      "preferredOrientations","orientacoesDeInteresse"
    ]);
  }

  function lacksPrivateProfileEmailFields() {
    return !resource.data.keys().hasAny([
      "email", "emailAddress", "registrationEmail",
      "authEmail", "accountEmail", "authorEmail"
    ]);
  }

  function approximateCoordinate(value, lower, upper) {
    return value == null || (
      value is number && value >= lower && value <= upper
      && value == int(value * 100 + (value < 0 ? -0.5 : 0.5)) / 100.0
    );
  }

  // O documento inteiro é exposto numa leitura direta, inclusive no legado.
  function publicLocationIsApproximate(data) {
    let geohash = data.get("geohash", null);
    return !data.keys().hasAny(["lat", "lng", "lon", "locationAccuracy", "lastLocationAt"])
      && approximateCoordinate(data.get("latitude", null), -90, 90)
      && approximateCoordinate(data.get("longitude", null), -180, 180)
      && (geohash == null || (geohash is string && geohash.matches("^[0123456789bcdefghjkmnpqrstuvwxyz]{5}$")));
  }

  allow get: if currentUserCanUseAdultSocialPlatform()
    && bilateralExposureAllows(userId)
    && canonicalOwnerLifecycleAllowsPublicMediaExposure(userId)
    && (isSelf(userId) || (
      lacksPrivateDiscoveryInterestFields()
      && lacksPrivateProfileEmailFields()
      && publicLocationIsApproximate(resource.data)
      && publicProfileTextFieldsValid(resource.data)
    ));

  allow list: if false;

  function privateUserPath() {
    return /databases/$(database)/documents/users/$(userId);
  }

  function nullableString(value) {
    return value == null || value is string;
  }

  function publicProfileTextFieldsValid(data) {
    return nullableString(data.get("nickname", null))
      && nullableString(data.get("nicknameNormalized", null))
      && nullableString(data.get("publicDescription", null))
      && nullableString(data.get("municipio", null))
      && nullableString(data.get("estado", null))
      && nullableString(data.get("orientation", null))
      && nullableString(data.get("avatarUrl", null))
      && nullableString(data.get("photoURL", null));
  }

  function privateUserEligibleAfter() {
    let user = getAfter(privateUserPath()).data;
    return user is map
      && user.emailVerified == true
      && user.profileCompleted == true
      && user.publicVisibility == "visible"
      && user.interactionBlocked == false
      && adultMediaHasCurrentTerms(user);
  }

  function privateUserEligibleCurrent() {
    let user = get(privateUserPath()).data;
    return user is map
      && user.emailVerified == true
      && user.profileCompleted == true
      && user.publicVisibility == "visible"
      && user.interactionBlocked == false
      && adultMediaHasCurrentTerms(user);
  }

  // Cliente não pode escolher apelido distinto na projeção após concluir cadastro.
  function nicknameMatchesPrivateAfter() {
    let owner = getAfter(privateUserPath()).data;
    return owner is map
      && owner.get("nickname", null) is string
      && request.resource.data.nickname == owner.get("nickname", null);
  }

  function createKeysValid() {
    return request.resource.data.keys().hasOnly([
      "uid",
      "nickname",
      "nicknameNormalized",
      "avatarUrl",
      "photoURL",
      "municipio",
      "estado",
      "gender",
      "identityCode",
      "identityCatalogVersion",
      "orientation",
      "role",
      "createdAt",
      "updatedAt"
    ])
      && request.resource.data.keys().hasAll([
        "uid",
        "nickname",
        "nicknameNormalized",
        "municipio",
        "estado",
        "gender",
        "identityCode",
        "identityCatalogVersion",
        "orientation",
        "role",
        "createdAt",
        "updatedAt"
      ]);
  }

  function updateKeysValid() {
    // Nickname e chave normalizada não são campos mutáveis no perfil público.
    return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      "avatarUrl",
      "photoURL",
      "municipio",
      "estado",
      "gender",
      "identityCode",
      "identityCatalogVersion",
      "orientation",
      "updatedAt"
    ]);
  }

  function identityMatchesPrivateDeclarationAfter() {
    let user = getAfter(privateUserPath()).data;
    let declaredCode = user.get(
      "declaredIdentityCode",
      user.get("gender", "")
    );
    let catalogVersion = user.get("identityCatalogVersion", 1);
    return request.resource.data.identityCode == declaredCode
      && request.resource.data.gender == user.get("gender", declaredCode)
      && request.resource.data.identityCatalogVersion == catalogVersion;
  }

  function identityMatchesPrivateDeclarationCurrent() {
    let user = get(privateUserPath()).data;
    let declaredCode = user.get(
      "declaredIdentityCode",
      user.get("gender", "")
    );
    let catalogVersion = user.get("identityCatalogVersion", 1);
    return request.resource.data.identityCode == declaredCode
      && request.resource.data.gender == user.get("gender", declaredCode)
      && request.resource.data.identityCatalogVersion == catalogVersion;
  }

  function identityChangeSafe() {
    let changed = request.resource.data.diff(resource.data).affectedKeys();
    let identityKeys = ["gender", "identityCode", "identityCatalogVersion"];
    return !changed.hasAny(identityKeys)
      || (
        changed.hasAll(identityKeys)
        && identityMatchesPrivateDeclarationCurrent()
      );
  }

  function avatarOnlyUpdate() {
    let changed = request.resource.data.diff(resource.data).affectedKeys();
    return changed.hasOnly(["photoURL", "avatarUrl", "updatedAt"])
      && changed.hasAny(["photoURL", "avatarUrl"])
      && request.resource.data.updatedAt == request.time;
  }

  allow create: if resource == null
    && isSelf(userId)
    && createKeysValid()
    && request.resource.data.uid == uid()
    && request.resource.data.role == "free"
    && request.resource.data.createdAt == request.time
    && request.resource.data.updatedAt == request.time
    && identityMatchesPrivateDeclarationAfter()
    && nicknameMatchesPrivateAfter()
    && publicProfileTextFieldsValid(request.resource.data)
    && privateUserEligibleAfter();

  allow update: if resource != null
    && isSelf(userId)
    && publicProfileTextFieldsValid(request.resource.data)
    && (
      avatarOnlyUpdate()
      || (
        updateKeysValid()
        && request.resource.data.uid == resource.data.uid
        && identityChangeSafe()
        && request.resource.data.updatedAt == request.time
      )
    )
    && privateUserEligibleCurrent();

  allow delete: if false;

  match /profile_viewers/{viewerUid} {
    allow read, write: if false;
  }
}
