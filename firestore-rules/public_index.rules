    // =======================================================================
    // PUBLIC INDEX (índice técnico)
    // ✅ ARQUIVO MODULAR: NÃO pode ter `rules_version` nem `service cloud.firestore`
    // uso de helpers globais
    // entretenimento\firestore-rules\public_index.rules
    // =======================================================================
match /public_index/{docId} {
  function isNicknameDoc() { return docId.matches('^nickname:.+'); }
  function isEmailDoc() { return docId.matches('^email:.+'); }

  function hasRequiredRequestFields() {
    return request.resource.data.keys().hasAll([
      "uid",
      "type",
      "value",
      "createdAt",
      "lastChangedAt"
    ]);
  }

  allow get: if isNicknameDoc()
    || (
      signedIn()
      && isEmailDoc()
      && resource.data.keys().hasAny(["uid"])
      && resource.data.uid == uid()
    );

  allow list: if false;

  function validDocId() { return isNicknameDoc() || isEmailDoc(); }

  function currentNicknameOwnerEligibleAfter() {
    let userPath = /databases/$(database)/documents/users/$(uid());
    let user = signedIn() && existsAfter(userPath)
      ? getAfter(userPath).data
      : null;

    return user is map
      && user.accountStatus == "active"
      && user.profileCompleted == true
      && user.publicVisibility == "visible"
      && user.interactionBlocked == false
      && adultMediaHasCurrentTerms(user)
      && adultMediaHasRequiredConsent(user);
  }

  // Bloqueia aliases arbitrários: a chave precisa representar o titular.
  // A normalização/ocupação histórica ainda será migrada para backend.
  function canonicalNicknameReservationAfter() {
    let profilePath = /databases/$(database)/documents/public_profiles/$(uid());
    let profile = signedIn() && existsAfter(profilePath)
      ? getAfter(profilePath).data
      : null;
    return profile is map
      && profile.get("uid", "") == uid()
      && profile.get("nicknameNormalized", "") is string
      && profile.nicknameNormalized.matches('^[a-z0-9._-]{3,40}$')
      && request.resource.data.type == "nickname"
      && docId == "nickname:" + profile.nicknameNormalized
      && request.resource.data.value == profile.nicknameNormalized;
  }

  function common() {
    return signedIn()
      && validDocId()
      && hasRequiredRequestFields()
      && request.resource.data.uid == uid()
      && request.resource.data.type in ["nickname","email"]
      && request.resource.data.type == (isNicknameDoc() ? "nickname" : "email")
      && request.resource.data.value is string
      // ✅ serverTimestamp obrigatório
      && request.resource.data.createdAt == request.time
      && request.resource.data.lastChangedAt == request.time;
  }

  allow create: if common()
    && (!isNicknameDoc() || (currentNicknameOwnerEligibleAfter()
      && canonicalNicknameReservationAfter()))
    && !exists(/databases/$(database)/documents/public_index/$(docId));

  allow update: if signedIn()
    && isEmailDoc()
    && hasRequiredRequestFields()
    && request.resource.data.uid == uid()
    && request.resource.data.type == "email"
    && request.resource.data.value is string
    && resource.data.keys().hasAny(["createdAt"])
    && request.resource.data.createdAt == resource.data.createdAt
    // ✅ serverTimestamp obrigatório no update
    && request.resource.data.lastChangedAt == request.time;

  // Cliente não pode liberar nickname. Backend gerencia exclusão/suspensão.
  allow delete: if signedIn()
    && isEmailDoc()
    && resource.data.keys().hasAny(["uid"])
    && resource.data.uid == uid();
}
