// ===============================================================
// PUBLIC SOCIAL LINKS
// - Espelho público da fonte privada users/{uid}/profileData/socialLinks.
// - O cliente nunca pode publicar valores diferentes da fonte privada.
// - Criação/alteração material exige assinatura + fronteira adulta canônica.
// - Remoção continua disponível ao dono após expiração.
// ===============================================================
match /public_social_links/{userId} {

  function privateSocialLinksPath() {
    return /databases/$(database)/documents/users/$(userId)/profileData/socialLinks;
  }

  function currentActorHasActiveSubscription() {
    let user = get(currentPrivateUserPath()).data;
    return user is map
      && activeSubscriptionRankFromProjection(user) > 0;
  }

  function allowedKeys() {
    return request.resource.data.keys().hasOnly([
      "uid",
      "facebook","instagram","twitter","linkedin","youtube","tiktok","snapchat",
      "sexlog","d4swing",
      "hotvips","privacy","onlyfans","fansly","linktree",
      "updatedAt"
    ]);
  }

  function mirrorsPrivateSourceAfterWrite() {
    let source = getAfter(privateSocialLinksPath()).data;
    let diff = request.resource.data.diff(source);

    return source is map
      && diff.addedKeys().hasOnly(["uid", "updatedAt"])
      && diff.addedKeys().hasAll(["uid", "updatedAt"])
      && diff.changedKeys().size() == 0
      && diff.removedKeys().size() == 0;
  }

  function removesOnly() {
    let diff = request.resource.data.diff(resource.data);
    return diff.addedKeys().size() == 0
      && diff.changedKeys().hasOnly(["updatedAt"])
      && diff.removedKeys().size() > 0;
  }

  function writeEnvelopeValid() {
    return request.resource.data.uid == uid()
      && allowedKeys()
      && request.resource.data.updatedAt == request.time
      && mirrorsPrivateSourceAfterWrite();
  }

  allow get: if signedIn()
    && (
      isSelf(userId)
      || (
        currentUserCanUseAdultSocialPlatform()
        && isActiveSubscriber(userId)
      )
    );
  allow list: if false;

  allow create: if isSelf(userId)
    && currentActorHasActiveSubscription()
    && currentUserCanUseAdultSocialPlatform()
    && writeEnvelopeValid();

  allow update: if isSelf(userId)
    && request.resource.data.uid == resource.data.uid
    && writeEnvelopeValid()
    && (
      removesOnly()
      || (
        currentActorHasActiveSubscription()
        && currentUserCanUseAdultSocialPlatform()
      )
    );

  allow delete: if isSelf(userId);
}
// ===============================================================
//                 FIM PUBLIC SOCIAL LINKS
// ===============================================================
