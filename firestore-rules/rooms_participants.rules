// ==================================================================
// ROOMS / participants (subcollection) — LEGACY READ COMPATIBILITY
// ==================================================================
// - leitura permanece restrita a participante real/owner da Sala existente;
// - toda escrita do navegador é negada;
// - rooms/{roomId}.participants continua sendo a projeção legada usada para
//   autorizar leitura enquanto os documentos históricos forem preservados.
//
// SUPRESSÃO EXPLÍCITA:
// - removidas create/update do próprio usuário e do owner;
// - removida validação de payload que só existia para essas escritas;
// - motivo: impedir uma segunda representação mutável de membership em um
//   domínio descontinuado.
// ==================================================================
match /rooms/{roomId}/participants/{userId} {

  function roomPath() {
    return /databases/$(database)/documents/rooms/$(roomId);
  }

  function roomExists() {
    return exists(roomPath());
  }

  function roomData() {
    return get(roomPath()).data;
  }

  function roomParticipants() {
    return roomData().participants is list ? roomData().participants : [];
  }

  function isRoomOwnerRequester() {
    return signedIn()
      && roomExists()
      && roomData().createdBy == uid();
  }

  function isRoomParticipantRequester() {
    return signedIn()
      && roomExists()
      && (uid() in roomParticipants());
  }

  function canReadParticipantDocs() {
    return isRoomParticipantRequester() || isRoomOwnerRequester();
  }

  allow get, list: if canReadParticipantDocs();
  allow create, update, delete: if false;
}
// ================================================================
//               FIM DO ROOMS_PARTICIPANTS.RULES
// ================================================================
