// ===============================================================
// USERS / videos
// - Biblioteca privada disponível somente para conta operacional.
// - Criação, processamento, publicação e exclusão ficam no backend.
// - Sem enumeração por terceiros e sem paths privados em projeções públicas.
// ===============================================================
match /users/{userId}/videos/{videoId} {
  allow get, list: if isOperationalMediaAccount(userId);
  allow create, update, delete: if false;

  match /{allPaths=**} {
    allow read, write: if false;
  }
}
// ===============================================================
//                         FIM DO USERS / VIDEOS
// ===============================================================
