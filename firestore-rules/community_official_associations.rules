// =============================================================================
// COMMUNITY OFFICIAL ASSOCIATIONS
// =============================================================================
// A associação canônica contém organização patrocinadora, responsável e origem
// da verificação. Nenhum desses dados pode ser consultado pelo navegador.
// Claims também contêm referências privadas de KYC/KYB/autoridade, identidade
// do solicitante, revisão e trilha de auditoria. A UI recebe somente projeções
// sanitizadas por callable/Discovery.
// =============================================================================

match /community_official_associations/{associationKey} {
  allow read, write: if false;
}

match /community_official_association_audit/{auditId} {
  allow read, write: if false;
}

match /community_official_claims/{associationKey} {
  allow read, write: if false;
}

match /community_official_claim_requests/{requestId} {
  allow read, write: if false;
}

match /community_official_claim_audit/{auditId} {
  allow read, write: if false;
}