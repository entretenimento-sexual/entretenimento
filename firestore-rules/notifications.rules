// ===============================================================
// firestore-rules/notifications.rules
// ===============================================================
// Notificações internas/push.
//
// Modelo atual:
// - backend/Admin SDK cria notificações;
// - Cloud Function sendNotification pode enviar FCM;
// - cliente autenticado pode ler apenas as próprias notificações;
// - cliente NÃO cria/edita/remove notificações nesta fase;
// - resumo multi-Comunidade é projeção privada backend-only;
// - estado interno da projeção não é exposto ao navegador.
//
// Segurança:
// - evita que usuário force push para terceiros;
// - evita manipulação de userId/read state enquanto não houver endpoint próprio;
// - marcação como lida passa por callable;
// - unread/priority por Comunidade nunca são autoridade do cliente.
// ===============================================================

match /notifications/{notificationId} {
  function isOwnNotification() {
    return signedIn() && resource.data.userId == uid();
  }

  allow get, list: if isOwnNotification();
  allow create, update, delete: if false;
}

match /community_notification_summaries/{userId}/items/{communityId} {
  allow get, list: if signedIn() && userId == uid();
  allow create, update, delete: if false;
}

match /community_notification_projection_state/{notificationId} {
  allow read, write: if false;
}