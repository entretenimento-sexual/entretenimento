// firestore-rules/community_boost.rules
// =============================================================================
// COMMUNITY BOOST - BACKEND ONLY
// =============================================================================
// Campanhas, placements, caps, métricas e faturamento patrocinado não são
// documentos de cliente. A UI recebe somente projeções sanitizadas por callable.
// =============================================================================

match /community_boost_advertiser_accounts/{advertiserUid} {
  allow read, write: if false;
}

match /community_boost_advertiser_account_requests/{requestId} {
  allow read, write: if false;
}

match /community_boost_active_slots/{communityId} {
  allow read, write: if false;
}

match /community_boost_campaigns/{campaignId} {
  allow read, write: if false;

  match /metrics_daily/{dayId} {
    allow read, write: if false;
  }

  match /billing_ledger/{dayId} {
    allow read, write: if false;
  }
}

match /community_boost_placements/{placementId} {
  allow read, write: if false;
}

match /community_boost_frequency_caps/{capId} {
  allow read, write: if false;
}

match /community_boost_campaign_requests/{requestId} {
  allow read, write: if false;
}

match /community_boost_billing_config/{configId} {
  allow read, write: if false;
}

match /community_boost_billing_config_requests/{requestId} {
  allow read, write: if false;
}

match /community_boost_audit/{auditId} {
  allow read, write: if false;
}
