// ==============================================================
// PUSH DEVICES (private backend-owned registry)
// ==============================================================
// Tokens FCM identificam instalações/dispositivos e não fazem parte do perfil.
// O cliente registra/remove tokens somente pelas Cloud Functions canônicas.
// A autoridade global por token também é exclusivamente server-side.
// Admin SDK ignora Firestore Rules; qualquer acesso direto do navegador falha.
// ==============================================================

match /users/{userId}/push_devices/{deviceId} {
  allow read, write: if false;
}

match /push_token_owners/{tokenId} {
  allow read, write: if false;
}
