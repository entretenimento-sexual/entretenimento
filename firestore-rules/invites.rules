// ================================================================
// INVITES.RULES
// ================================================================
// - leitura: somente sender/receiver;
// - criação: somente Cloud Functions/Admin SDK;
// - resposta accepted/declined: somente Cloud Functions/Admin SDK;
// - cliente sender pode cancelar/expirar somente convites legados não Community;
// - convites de Comunidade são integralmente backend-only para preservar
//   membership, métricas, entitlement, bloqueios e auditoria transacionais.
// ================================================================
match /invites/{inviteId} {

  function isSender() {
    return signedIn() && resource.data.senderId == uid();
  }

  function isReceiver() {
    return signedIn() && resource.data.receiverId == uid();
  }

  function isCommunityInvite() {
    return resource.data.type == "community";
  }

  allow get: if signedIn() && (isSender() || isReceiver());

  // A consulta do inbox precisa restringir receiverId/status no cliente.
  allow list: if signedIn() && (isSender() || isReceiver());

  /**
   * SUPRESSÃO EXPLÍCITA:
   * - removida a criação direta pelo sender no navegador;
   * - removidos validCreateV2/validCreateLegacyRoom, pois Rules não conseguem
   *   validar integralmente autoridade na sala, bloqueios e elegibilidade;
   * - sendRoomInvite/sendCommunityInvite usam Admin SDK, request.auth.uid e
   *   transações auditadas.
   */
  allow create: if false;

  /**
   * SUPRESSÃO EXPLÍCITA:
   * - receiver não pode aceitar/recusar por update direto;
   * - convites de Comunidade também não podem ser cancelados/expirados por
   *   update direto do sender, pois revokeCommunityInvite precisa manter a
   *   trilha de auditoria e a política comunitária coerentes;
   * - callables usam Admin SDK e revalidam membership, entitlement e bloqueios.
   */
  allow update: if !isCommunityInvite()
    && signedIn()
    && resource.data.status == "pending"
    && request.resource.data.status != resource.data.status
    && request.resource.data.diff(resource.data).changedKeys().hasOnly([
      "status",
      "respondedAt",
      "updatedAt"
    ])
    && (
      (isSender()
        && request.resource.data.status in ["expired", "canceled"]
        && request.resource.data.updatedAt == request.time
        && (
          !("respondedAt" in request.resource.data)
          || request.resource.data.respondedAt == resource.data.respondedAt
        )
      )
      || isAdmin() == true
    );

  // Delete direto permanece somente para convites legados não Community.
  allow delete: if !isCommunityInvite()
    && signedIn()
    && isSender()
    && resource.data.status == "pending";
}
// ================================================================
// FIM DE INVITES.RULES
// ================================================================
