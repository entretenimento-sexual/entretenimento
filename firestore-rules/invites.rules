// ================================================================
// INVITES.RULES
// ================================================================
// - leitura: somente sender/receiver;
// - criação: somente Cloud Functions/Admin SDK;
// - resposta accepted/declined: somente Cloud Functions/Admin SDK;
// - toda mutação é backend-only, inclusive resíduos de convites de Sala;
// - convites de Comunidade e Sala preservam membership, métricas, bloqueios
//   e auditoria transacionais no backend.
// ================================================================
match /invites/{inviteId} {

  function isSender() {
    return signedIn() && resource.data.senderId == uid();
  }

  function isReceiver() {
    return signedIn() && resource.data.receiverId == uid();
  }

  function isCommunityInvite() {
    return resource.data.type == "community";
  }

  allow get: if currentUserCanUseAdultSocialPlatform()
    && (isSender() || isReceiver());

  // A consulta do inbox precisa restringir receiverId/status no cliente.
  allow list: if currentUserCanUseAdultSocialPlatform()
    && (isSender() || isReceiver());

  /**
   * SUPRESSÃO EXPLÍCITA:
   * - removida a criação direta pelo sender no navegador;
   * - removidos validCreateV2/validCreateLegacyRoom, pois Rules não conseguem
   *   validar integralmente autoridade na sala, bloqueios e elegibilidade;
   * - sendRoomInvite/sendCommunityInvite usam Admin SDK, request.auth.uid e
   *   transações auditadas.
   */
  allow create: if false;

  // Resposta, cancelamento, expiração e exclusão passam exclusivamente
  // pelas callables canônicas. Não mantemos exceção client-side para Room.
  allow update, delete: if false;
}
// ================================================================
// FIM DE INVITES.RULES
// ================================================================
